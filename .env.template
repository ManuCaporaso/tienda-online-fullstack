# ══════════════════════════════════════════════════════════════
# BACKEND (NestJS) — copiar a backend/.env
# ══════════════════════════════════════════════════════════════

# Base de datos (MariaDB / MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/icarodb"

# Servidor
NODE_ENV=development
PORT=3030
# Lista separada por comas (localhost + IP de tu red local)
CORS_ORIGIN="http://localhost:3000,http://192.168.0.147:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:3030"

# Auth / JWT
JWT_SECRET="super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="1d"

# Usuario administrador inicial (usado por prisma/seed.ts)
# Si no se definen, el seed usa admin@admin.com / admin / Administrador.
ADMIN_EMAIL="tu_email_admin@ejemplo.com"
ADMIN_PASSWORD="tu_password_segura"
ADMIN_NAME="Administrador"

# Email / verificación de cuentas (Nodemailer)
# Si no se configuran SMTP_*, el backend imprime el enlace en consola.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu@gmail.com"
# SMTP_PASS="tu_app_password"
# MAIL_FROM="Patagonia Sports <no-reply@patagoniasports.com>"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADOPAGO_WEBHOOK_SECRET="tu_webhook_secret_o_signature"

# ══════════════════════════════════════════════════════════════
# FRONTEND (Next.js) — copiar a frontend/.env.local
# ══════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL="http://localhost:3030"
API_URL="http://localhost:3030"

# Hostnames (sin esquema ni puerto) extra permitidos por el dev server de Next.
# Necesario para abrir el frontend desde otra máquina/IP de la LAN y que
# carguen los assets de desarrollo y el WebSocket del HMR.
# Ejemplo: ALLOWED_DEV_ORIGINS="192.168.0.147,192.168.1.50"
# ALLOWED_DEV_ORIGINS="192.168.0.147"
